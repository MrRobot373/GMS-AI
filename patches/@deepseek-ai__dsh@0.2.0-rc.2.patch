-if (import.meta.main) await runCli();
+// Aatmiq: import.meta.main only exists from Node 22.18 / 24.2; on older Node the CLI exited at once without running.
+// The script's own path in argv says the same thing on every Node.
+const ranDirectly = import.meta.main ?? (await (async () => {
+	try {
+		const { realpathSync } = await import("node:fs");
+		const { fileURLToPath } = await import("node:url");
+		return process.argv[1] !== void 0 && realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url));
+	} catch {
+		return false;
+	}
+})());
+if (ranDirectly) await runCli();
 //#endregion
 export { runCli };
